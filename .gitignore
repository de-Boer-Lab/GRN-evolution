# Byte-compiled / cache files
__pycache__/
*.pyc
*.pyo

# OS-generated files
.DS_Store

# Python virtual environments
venv/
.env/

# Robustness outputs (large, regenerated by scripts)
analyses/robustness-outputs/

# Simulation checkpoints and logs (regenerated by scripts)
checkpoints/
simulation-code/*/checkpoints/
simulation-code/*/logs/

# Ignore any stray pickle files (checkpoints)
*.pkl

# Large or intermediate data files (measures, temporary output)
*.measures

# Compression archives
*.tar
*.tar.gz
*.zip

